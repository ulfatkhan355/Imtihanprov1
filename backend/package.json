{
  "name": "imtihan-pro-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply imtihan-pro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply imtihan-pro-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply imtihan-pro-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply imtihan-pro-db --remote",
    "d1:seed:local": "wrangler d1 execute imtihan-pro-db --local --file=./migrations/0002_seed_kpk_sample.sql",
    "d1:seed:remote": "wrangler d1 execute imtihan-pro-db --remote --file=./migrations/0002_seed_kpk_sample.sql"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "wrangler": "^3.108.0"
  }
}
