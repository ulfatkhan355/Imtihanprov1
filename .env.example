# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin Dashboard (Vite client) — URL of deployed or local Cloudflare Worker API (`imtihan-pro-api`)
VITE_API_BASE_URL="http://localhost:8787/v1"

# Android / Deployment configuration placeholders (never commit live credentials)
IMTIHAN_API_BASE_URL="http://localhost:8787/v1"
B2_KEY_ID="REPLACE_WITH_B2_KEY_ID"
B2_APPLICATION_KEY="REPLACE_WITH_B2_APPLICATION_KEY"
B2_BUCKET_NAME="imtihan-pro-assets"
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
ADMIN_SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
ADMIN_BOOTSTRAP_SECRET="REPLACE_WITH_ONE_TIME_BOOTSTRAP_TOKEN"
AGENT_INGEST_SECRET="REPLACE_WITH_AGENT_INGEST_SECRET"
GOOGLE_OAUTH_CLIENT_ID=""
